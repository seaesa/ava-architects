 "content": "<div id=\"content\" role=\"main\" class=\"content-area\">\n\n\t\t\n\t\t\t\n\t<section class=\"section\" id=\"section_1207912543\">\n\t\t<div class=\"section-bg fill\">\n\t\t\t\t\t\t\t\t\t\n\t\t\t\n\n\t\t</div>\n\n\t\t\n\n\t\t<div class=\"section-content relative\">\n\t\t\t\n\n  <div class=\"banner has-hover bg-zoom bg-overlay-remove-50\" id=\"banner-1280360327\">\n          <div class=\"banner-inner fill\">\n        <div class=\"banner-bg fill\">\n            <img width=\"1366\" height=\"911\" src=\"https://ava-architects.vn/wp-content/uploads/2025/01/banner-ava-architects.jpg\" class=\"bg attachment-original size-original\" alt=\"banner ava architects\" title=\"Về AVA Architects 1\">                        <div class=\"overlay\"></div>            \n                    </div>\n\t\t\n\t<div class=\"ux-shape-divider ux-shape-divider--bottom ux-shape-divider--style-waves-opacity-3\">\n\t\t<svg viewBox=\"0 0 1000 300\" xmlns=\"http://www.w3.org/2000/svg\" preserveAspectRatio=\"none\">\n\t<path class=\"ux-shape-fill\" opacity=\"0.05\" d=\"M1014 264V386H206L34 300C34 300 344.42 277.16 436 221C542 156 590 160 704 209C811 255 899.11 214.94 979 346L1014 264Z\"></path>\n\t<path class=\"ux-shape-fill\" opacity=\"0.1\" d=\"M-302 55C-302 55 -66.73 263.25 50 214C178 160 283 116 353 141C445.68 174.1 534.28 256.19 588 249C692.9 235 764.52 75.94 855 131C940.61 183.09 1000 254 1000 254V328L-306 338L-302 55Z\"></path>\n\t<path class=\"ux-shape-fill\" opacity=\"0.15\" d=\"M-286 255C-286 255 -72 152 52 126C176 100 255 155 436 227C581.57 284.91 614.7 277.79 708 227C787 184 1009 3.0001 1093 164C1146 265.63 1031 293 1031 293L924 377L-288 389L-286 255Z\"></path>\n\t<path class=\"ux-shape-fill\" opacity=\"0.3\" d=\"M-24 69C-24 69 275.68 370.66 389 314C397 310 622 316 673 356C690.47 369.7 845 224 890 182C944.8 130.85 1018 92 1078 143C1154.12 207.7 1196 242 1196 242L1184 374L-28 386L-24 69Z\"></path>\n\t<path class=\"ux-shape-fill\" d=\"M-12 201C-12 201 58 284 182 258C306 232 342.29 221.23 456 264C565 305 640.82 288.36 721 249C776 222 837.5 191.31 935 253C984 284 1030 279 1030 279L1024 430L-12 440V201Z\"></path>\n</svg>\n\t</div>\n        <div class=\"banner-layers container\">\n            <div class=\"fill banner-link\"></div>            \n   <div id=\"text-box-772913801\" class=\"text-box banner-layer x50 md-x50 lg-x50 y50 md-y50 lg-y50 res-text\">\n                                <div class=\"text-box-content text dark\">\n              \n              <div class=\"text-inner text-center\">\n                  \n<h2><span style=\"font-size: 80%;\">LẤY CON NGƯỜI LÀM TRỌNG TÂM. KIẾN TẠO GIÁ TRỊ BỀN VỮNG</span></h2>\n              </div>\n           </div>\n                            \n\n    </div>\n \n        </div>\n      </div>\n\n            \n\n  </div>\n\n\n\t\t</div>\n\n\t\t\n\n\t</section>\n\t\n\n\t<section class=\"section\" id=\"section_668080936\">\n\t\t<div class=\"section-bg fill\">\n\t\t\t\t\t\t\t\t\t\n\t\t\t\n\n\t\t</div>\n\n\t\t\n\n\t\t<div class=\"section-content relative\">\n\t\t\t\n<div class=\"is-divider divider clearfix\" style=\"background-color:rgba(0, 0, 0, 0);\"></div>\n<div class=\"container section-title-container\"><h3 class=\"section-title section-title-normal\"><b></b><span class=\"section-title-main\">Về AVA ARCHITECTS</span><b></b></h3></div>\n<div class=\"row\" id=\"row-1550685981\">\n\n\t<div id=\"col-446102670\" class=\"col small-12 large-12\">\n\t\t\t\t<div class=\"col-inner\">\n\t\t\t\n\t\t\t\n\t<div id=\"text-3227417899\" class=\"text\">\n\t\t\n<p style=\"text-align: justify;\"><span style=\"font-size: 120%;\">Thành lập từ 2009 bởi <strong>KTS Huy Vũ và những cộng sự</strong>, AVA Architects là đơn vị chuyên thiết kế và thi công xây dựng hàng đầu tại Việt Nam và đặc biệt nổi bật tại Đà Nẵng. Chúng tôi có tập thể gồm các kiến trúc sư, kỹ sư và những chuyên gia hàng đầu giúp hiện thực hóa các ý tưởng độc đáo của khách hàng thành những công trình chất lượng, bền vững và hiệu quả. <strong>Công nghệ BIM</strong> được tích hợp ngay từ khâu thiết kế của chúng tôi.</span></p>\n\t\t\n\n\t</div>\n\t\n<div class=\"is-divider divider clearfix\"></div>\n\t<div id=\"text-3253063623\" class=\"text\">\n\t\t\n<p style=\"text-align: justify;\"><span style=\"font-size: 120%;\">Với kinh nghiệm trải qua nhiều dự án với đa dạng mô hình, AVA tự tin có thể thực hiện không chỉ tốt mà còn hiệu quả nhiều loại dự án khác nhau, bao gồm: Nhà phố, biệt thự, căn hộ, khách sạn, khu nghỉ dưỡng, tòa nhà văn phòng, và còn hơn thế nữa !</span></p>\n\t\t\n\n\t</div>\n\t\n<div class=\"is-divider divider clearfix\"></div>\n  <div class=\"slider-wrapper relative\" id=\"slider-1793487085\">\n    <div class=\"slider slider-nav-dots-dashes slider-nav-simple slider-nav-large slider-nav-dark slider-style-normal slider-1793487085\" data-flickity-options=\"{\n            \n            &quot;cellAlign&quot;: &quot;center&quot;,\n            &quot;imagesLoaded&quot;: true,\n            &quot;lazyLoad&quot;: 1,\n            &quot;freeScroll&quot;: false,\n            &quot;wrapAround&quot;: false,\n            &quot;autoPlay&quot;: 4000,\n            &quot;pauseAutoPlayOnHover&quot; : true,\n            &quot;prevNextButtons&quot;: false,\n            &quot;contain&quot; : true,\n            &quot;adaptiveHeight&quot; : true,\n            &quot;dragThreshold&quot; : 10,\n            &quot;percentPosition&quot;: true,\n            &quot;pageDots&quot;: false,\n            &quot;rightToLeft&quot;: false,\n            &quot;draggable&quot;: true,\n            &quot;selectedAttraction&quot;: 0.1,\n            &quot;parallax&quot; : 0,\n            &quot;friction&quot;: 0.6        }\">\n      \n\t<div class=\"img has-hover x md-x lg-x y md-y lg-y\" id=\"image_583848571\">\n\t\t\t\t\t\t\t\t<div class=\"img-inner image-cover dark\" style=\"padding-top:56.25%;\">\n\t\t\t<img width=\"2373\" height=\"1317\" src=\"https://ava-architects.vn/wp-content/uploads/2025/01/AVA_Architects_01.png\" class=\"attachment-original size-ori