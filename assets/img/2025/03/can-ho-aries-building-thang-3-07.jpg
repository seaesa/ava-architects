<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Chỉ áp dụng trên màn hình nhỏ hơn 768px
        if (window.innerWidth <= 768) {
            // Lấy các ul cần lọc
            const nav1 = document.querySelector(".nav.nav-true:first-of-type");
            const nav2 = document.querySelector(".nav.nav2");

            if (nav1 && nav2) {
                // Tạo các nhóm lọc
                const filterGroup1 = document.createElement("div");
                const filterGroup2 = document.createElement("div");

                // Tạo label cho từng nhóm lọc
                const label1 = document.createElement("div");
                label1.textContent = "Lọc bởi loại hình";
                label1.style.background = "#f5f5f5";
                label1.style.padding = "0.5rem";
                label1.style.cursor = "pointer";
                label1.style.fontWeight = "bold";
                label1.style.textTransform = "uppercase";
                label1.style.border = "1px solid #ddd";
                label1.style.marginBottom = "0.5rem";

                const label2 = label1.cloneNode();
                label2.textContent = "Lọc bởi loại dự án";

                // Bọc các ul trong div và ẩn chúng mặc định
                const content1 = document.createElement("div");
                const content2 = document.createElement("div");

                content1.style.display = "none";
                content2.style.display = "none";

                content1.appendChild(nav1);
                content2.appendChild(nav2);

                // Gắn label và nội dung vào từng nhóm
                filterGroup1.appendChild(label1);
                filterGroup1.appendChild(content1);

                filterGroup2.appendChild(label2);
                filterGroup2.appendChild(content2);

                // Chèn các nhóm này vào DOM trước container
                const container = document.querySelector(".container.mb-half");
                container.prepend(filterGroup2);
                container.prepend(filterGroup1);

                // Thêm sự kiện click để ẩn/hiện nội dung
                [label1, label2].forEach((label, index) => {
                    label.addEventListener("click", function() {
                        const content = index === 0 ? content1 : content2;
                        content.style.display = content.style.display === "none" ? "block" : "none";
                    });
                });
            }
        }
    });
</script>
</div>
</body>

</html>